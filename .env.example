# Disaster Alert and Community Response App
# Root Environment Template

# Back-End Express API Service Environment Variables
PORT=5000
NODE_ENV=development

# MySQL Relational Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=disaster_user
DB_PASSWORD=disaster_password
DB_NAME=disaster_response_db

# JWT Authentication Configuration
JWT_SECRET=supersecretjwtkey_change_in_production
JWT_EXPIRES_IN=7d

# CORS Allowed Origin Whitelist (Production Frontend URL)
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Front-End React/Vite SPA Environment Variable
VITE_API_BASE_URL=http://localhost:5000/api/v1
