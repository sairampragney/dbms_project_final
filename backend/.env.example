# Express REST API Server Environment Variables
PORT=5000
NODE_ENV=development

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=disaster_user
DB_PASSWORD=disaster_password
DB_NAME=disaster_response_db

# SSL/TLS Configuration for Cloud Databases (e.g. Aiven MySQL)
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true

# JWT Configuration
JWT_SECRET=supersecretjwtkey_change_in_production
JWT_EXPIRES_IN=7d

# CORS Allowed Origin Whitelist (Production Frontend URL)
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000
